{
  "name": "capacitor-native-navigation-react-router",
  "version": "7.1.1",
  "description": "React Router support for Native navigation for Capacitor apps",
  "type": "module",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": "./dist/esm/index.js"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cactuslab/capacitor-native-navigation.git"
  },
  "bugs": {
    "url": "https://github.com/cactuslab/capacitor-native-navigation/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "build": "tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "capacitor-native-navigation": "workspace:*",
    "capacitor-native-navigation-react": "workspace:*"
  },
  "devDependencies": {
    "capacitor-native-navigation": "workspace:*",
    "@capacitor/core": "^6.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react-router-dom": "^6.23.1",
    "rimraf": "^5.0.7",
    "rollup": "^4.18.0",
    "typescript": "~5.5.2"
  },
  "peerDependencies": {
    "@capacitor/core": "^5.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.4.3"
  }
}
